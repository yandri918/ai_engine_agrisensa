    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "values": [
              {"name": "Content-Type", "value": "application/json"},
              {"name": "X-AgriSensa-Engine", "value": "n8n-orchestrator"},
              {"name": "X-Request-ID", "value": "={{ $('🔀 Intent Router').item.json._request_id }}"}
            ]
          }
        }
      },
      "id": "respond-webhook",
      "name": "✅ Respond to Client",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 400]
    },
    {
      "parameters": {
        "jsCode": "// Rate limiter & API key validator\nconst body = $input.first().json;\nconst apiKey = body.api_key || $input.first().json.headers?.['x-api-key'];\n\n// Simple validation (extend with Redis rate limiting as needed)\nconst requiredFields = {\n  rag_chat: ['query'],\n  ml_inference: ['task'],\n  computer_vision: ['image_base64'],\n  market_intelligence: ['commodity'],\n  weather_climate: ['latitude', 'longitude']\n};\n\nreturn $input.all();"
      },
      "id": "request-validator",
      "name": "🔐 Request Validator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 300]
    }
  ],
