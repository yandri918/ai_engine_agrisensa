{
  "name": "WF-00: AgriSensa Master Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agrisensa/gateway",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-master",
      "name": "🌾 AgriSensa Gateway",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// AgriSensa Master Orchestrator — Intent Router\n// Routes incoming requests to appropriate sub-workflows\n// ============================================================\n\nconst body = $input.first().json.body || $input.first().json;\nconst headers = $input.first().json.headers || {};\n\n// Extract key fields\nconst intent = body.intent || body.task || null;\nconst query = body.query || body.message || '';\nconst hasFile = body.has_file || headers['content-type']?.includes('multipart') || body.file_base64 || false;\n\n// Auto-detect intent from query if not explicitly provided\nfunction detectIntent(text) {\n  const t = text.toLowerCase();\n  if (t.includes('analyst') || t.includes('analis') || t.includes('strategic') || t.includes('strategis') || t.includes('eksekutif') || t.includes('insight bisnis') || t.includes('dashboard analitik')) {\n    return 'data_analyst';\n  }\n  if (body.tool || body.url || body.file_base64 || t.includes('scrape') || t.includes('cari web') || t.includes('search')) {\n    return 'mcp_tools';\n  }\n  if (t.includes('monte') || t.includes('rab') || t.includes('bep') || t.includes('carbon') || t.includes('karbon') || t.includes('co2') || t.includes('forecast')) {\n    return 'advanced_engine';\n  }\n  if (hasFile || t.includes('gambar') || t.includes('foto') || t.includes('penyakit') || t.includes('daun')) {\n    return 'computer_vision';\n  }\n  if (t.includes('harga') || t.includes('pasar') || t.includes('komoditas') || t.includes('market')) {\n    return 'market_intelligence';\n  }\n  if (t.includes('cuaca') || t.includes('iklim') || t.includes('kalender tanam') || t.includes('lokasi')) {\n    return 'weather_climate';\n  }\n  if (\n    (t.includes('rekomendasi') && (t.includes('tanaman') || t.includes('pupuk'))) ||\n    t.includes('prediksi') || t.includes('npk') || t.includes('hasil panen') ||\n    t.includes('ton/ha') || t.includes('keberhasilan')\n  ) {\n    return 'ml_inference';\n  }\n  // Default: chat / RAG\n  return 'rag_chat';\n}\n\nconst resolvedIntent = intent || detectIntent(query);\n\n// Map to sub-workflow webhook paths\nconst routeMap = {\n  'data_analyst': '/webhook/agrisensa/analyst',\n  'rag_chat': '/webhook/agrisensa/chat',\n  'ml_inference': '/webhook/agrisensa/ml',\n  'computer_vision': '/webhook/agrisensa/vision',\n  'market_intelligence': '/webhook/agrisensa/market',\n  'weather_climate': '/webhook/agrisensa/weather',\n  'advanced_engine': '/webhook/agrisensa/advanced',\n  'mcp_tools': '/webhook/agrisensa/mcp',\n  'mlops_monitor': '/webhook/agrisensa/mlops',\n  'notification': '/webhook/agrisensa/notify'\n};\n\nreturn [{\n  json: {\n    ...body,\n    _intent: resolvedIntent,\n    _route: routeMap[resolvedIntent] || routeMap['rag_chat'],\n    _timestamp: new Date().toISOString(),\n    _request_id: Math.random().toString(36).substr(2, 9)\n  }\n}];"
      },
      "id": "intent-router",
      "name": "🔀 Intent Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json._intent }}", "rightValue": "rag_chat", "operator": {"type": "string", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "RAG Chat"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json._intent }}", "rightValue": "ml_inference", "operator": {"type": "string", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "ML Inference"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json._intent }}", "rightValue": "computer_vision", "operator": {"type": "string", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "Computer Vision"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json._intent }}", "rightValue": "market_intelligence", "operator": {"type": "string", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "Market Intelligence"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json._intent }}", "rightValue": "weather_climate", "operator": {"type": "string", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "Weather Climate"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json._intent }}", "rightValue": "advanced_engine", "operator": {"type": "string", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "Advanced Engine"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json._intent }}", "rightValue": "mcp_tools", "operator": {"type": "string", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "MCP Tools"
            }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "workflow-switch",
      "name": "⚡ Workflow Dispatcher",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_HOST_URL || 'http://localhost:5678' }}/webhook/agrisensa/chat",
        "sendBody": true,
        "bodyParameters": {"parameters": [{"name": "={{ Object.keys($json) }}", "value": "={{ $json }}"}]},
        "options": {"response": {"response": {"neverError": true}}}
      },
      "id": "call-rag-chat",
      "name": "📨 Call RAG Chat WF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 100]
    },
    {
      "parameters": {
