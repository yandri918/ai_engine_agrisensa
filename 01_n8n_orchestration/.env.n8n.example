# ============================================================
# AgriSensa n8n AI Engine — Environment Variables
# Salin file ini sebagai .env.n8n dan isi dengan nilai yang sesuai
# ============================================================

# ----------------------------------------------------------
# n8n Configuration
# ----------------------------------------------------------
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=agrisensa
N8N_BASIC_AUTH_PASSWORD=agrisensa2026_CHANGE_THIS

# ----------------------------------------------------------
# Database (PostgreSQL untuk n8n)
# ----------------------------------------------------------
N8N_DB_NAME=n8n_agrisensa
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_secret_CHANGE_THIS

# ----------------------------------------------------------
# Redis (Session Cache & Queue)
# ----------------------------------------------------------
REDIS_PASSWORD=redis_secret_CHANGE_THIS

# ----------------------------------------------------------
# AI / LLM APIs
# ----------------------------------------------------------
# Google Gemini AI (wajib untuk WF-01 RAG Chat)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (opsional, fallback LLM)
OPENAI_API_KEY=

# Hugging Face (untuk embedding model)
HUGGINGFACE_API_KEY=hf_your_key_here

# ----------------------------------------------------------
# Computer Vision
# ----------------------------------------------------------
# Roboflow (untuk WF-03 Plant Disease Detection)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=andriyanto39
ROBOFLOW_WORKFLOW_ID=detect-and-classify

# ----------------------------------------------------------
# Weather APIs (untuk WF-05 Weather & Climate Engine)
# ----------------------------------------------------------
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# ----------------------------------------------------------
# Market Data (untuk WF-04 Market Intelligence)
# ----------------------------------------------------------
BAPANAS_API_KEY=
BAPANAS_BASE_URL=https://panelharga.badanpangan.go.id

# ----------------------------------------------------------
# Notifications (untuk WF-07)
# ----------------------------------------------------------
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id

# Firebase Cloud Messaging (PWA Push)
FIREBASE_SERVER_KEY=your_firebase_server_key

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ADMIN_EMAIL=yandri918@gmail.com

# ----------------------------------------------------------
# AgriSensa Internal Services
# ----------------------------------------------------------
# FastAPI AI Core (running locally or in Docker)
AGRISENSA_API_URL=http://host.docker.internal:8000

# ChromaDB Vector Store
AGRISENSA_CHROMADB_URL=http://host.docker.internal:8001

# MLflow (untuk WF-06 MLOps Monitor)
AGRISENSA_MLFLOW_URL=http://host.docker.internal:5000

# ----------------------------------------------------------
# AgriSensa Thresholds & Business Logic
# ----------------------------------------------------------
# Market Intelligence: alert jika harga berubah lebih dari X%
PRICE_CHANGE_ALERT_THRESHOLD=5.0

# MLOps: alert jika akurasi turun lebih dari X%
MODEL_DRIFT_THRESHOLD=3.0

# Rate limiting: max requests per minute per session
RATE_LIMIT_PER_MINUTE=30
